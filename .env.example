# Copy this file to `.env.local` and fill in the values below.
# `.env.local` is git-ignored — never commit real secrets.
#
# Developing locally without a real Firebase project yet? Run
# `npm run emulators` and use the emulator block from the README /
# .env.local instead of the Firebase Admin SDK + Web SDK sections below —
# the app works end-to-end against the Firebase Local Emulator Suite with
# no real project at all.

# ---------------------------------------------------------------------------
# Access keys — shared passkeys that gate student vs. admin access.
# Change these before going live if you want to rotate them.
# ---------------------------------------------------------------------------
STUDENT_ACCESS_KEY=MYP5Students2027
ADMIN_ACCESS_KEY=StudentCouncilMYP5GradeAmbassador2029@

# ---------------------------------------------------------------------------
# Session signing secret — any random string, 32+ characters.
# Generate one with: openssl rand -base64 48
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-this-with-a-random-32-plus-character-secret

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-only) — from Project Settings > Service Accounts
# > Generate new private key. Paste the three matching values from that JSON
# file below. Keep the quotes around FIREBASE_PRIVATE_KEY exactly as shown.
#
# FIREBASE_STORAGE_BUCKET is OPTIONAL. As of October 2024, Firebase requires
# the paid Blaze plan (a card on file) just to enable Cloud Storage for
# Firebase at all — Auth and Firestore stay free on Spark. If you can't/don't
# want to enable Storage, leave FIREBASE_STORAGE_BUCKET and
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET below unset: the app runs fully on
# Auth + Firestore, and file uploads are replaced by Link resources (Google
# Drive, Google Docs/Slides/Sheets, YouTube, or any URL) — see DEPLOYMENT.md.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ---------------------------------------------------------------------------
# Firebase Web SDK (public, safe to expose to the browser) — from Project
# Settings > General > Your apps > SDK setup and configuration.
#
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET is OPTIONAL (see note above) — leaving
# it unset also disables the "Upload file" option in the admin UI in favor
# of Link resources.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
