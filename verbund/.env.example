# Copy to .env (same folder) to change settings. Every line is optional.

# Where the SQLite database lives (default: data/verbund.db inside this folder)
# VERBUND_DB=data/verbund.db

# Fill an empty database with the fictional demo students on first start (1 = yes, 0 = no)
# VERBUND_SEED_DEMO=1

# Local AI through Ollama (see docs/OLLAMA_SETUP.md)
# OLLAMA_ENABLED=1
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_TIMEOUT=90
